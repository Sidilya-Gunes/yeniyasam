{
  "kind": "collectionType",
  "collectionName": "videolar",
  "info": {
    "singularName": "video",
    "pluralName": "videolar",
    "displayName": "📹 Videolar & Medya",
    "description": "Yeni Yaşam video bülten ve röportajları"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Genel",
        "Politika",
        "Güncel",
        "Dünya",
        "Kadın",
        "Ekoloji",
        "Ekonomi",
        "Kültür-Sanat",
        "Söyleşi",
        "Dosya",
        "Forum",
        "Özel Haber",
        "Toplum-Yaşam",
        "Gençlik",
        "Spor",
        "Manşet",
        "Analiz"
      ],
      "default": "Genel"
    },
    "description": {
      "type": "text"
    },
    "duration": {
      "type": "string"
    },
    "videoUrl": {
      "type": "string",
      "required": true
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    }
  }
}
