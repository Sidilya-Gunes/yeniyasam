{
  "kind": "collectionType",
  "collectionName": "soylesiler",
  "info": {
    "singularName": "soylesi",
    "pluralName": "soylesiler",
    "displayName": "🎙️ Söyleşi & Dosya",
    "description": "Özel röportajlar ve kapsamlı dosya haberler"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "kicker": {
      "type": "enumeration",
      "enum": [
        "Söyleşi",
        "Dosya",
        "Forum",
        "Özel Haber",
        "Röportaj",
        "Analiz"
      ],
      "default": "Söyleşi"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "authorName": {
      "type": "string"
    },
    "isHeadline": {
      "type": "boolean",
      "default": false
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "readTime": {
      "type": "string"
    },
    "videoUrl": {
      "type": "string"
    },
    "yazar": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::yazar.yazar"
    }
  }
}
