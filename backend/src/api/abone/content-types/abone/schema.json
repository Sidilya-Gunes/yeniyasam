{
  "kind": "collectionType",
  "collectionName": "aboneler",
  "info": {
    "singularName": "abone",
    "pluralName": "aboneler",
    "displayName": "📋 Aboneler & Üyelikler",
    "description": "Yeni Yaşam dijital e-gazete ve dayanışma aboneleri"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true,
      "unique": true
    },
    "phone": {
      "type": "string"
    },
    "plan": {
      "type": "enumeration",
      "enum": [
        "Yurt İçi 6 Aylık E-Abonelik",
        "Yurt İçi Yıllık E-Abonelik",
        "Yurt İçi Yıllık Destek (1)",
        "Yurt İçi Yıllık Destek (2)",
        "Yurt İçi Yıllık Destek (3)",
        "Yurt Dışı 6 Aylık E-Abonelik",
        "Yurt Dışı Yıllık E-Abonelik",
        "Yurt Dışı Yıllık Destek (1)",
        "Yurt Dışı Yıllık Destek (2)",
        "Yurt Dışı Yıllık Destek (3)",
        "Özel / Kurumsal / Basılı"
      ],
      "required": true,
      "default": "Yurt İçi Yıllık E-Abonelik"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Aktif",
        "Süresi Doldu",
        "Beklemede",
        "İptal Edildi"
      ],
      "required": true,
      "default": "Aktif"
    },
    "startDate": {
      "type": "date"
    },
    "endDate": {
      "type": "date"
    },
    "price": {
      "type": "decimal"
    },
    "currency": {
      "type": "enumeration",
      "enum": [
        "TRY",
        "EUR",
        "USD"
      ],
      "default": "TRY"
    },
    "paymentMethod": {
      "type": "string",
      "default": "iyzico"
    },
    "orderId": {
      "type": "string"
    },
    "notes": {
      "type": "text"
    }
  }
}
